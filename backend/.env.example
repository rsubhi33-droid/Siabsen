NODE_ENV=development
PORT=8000
CORS_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=siabsen
DB_USER=root
DB_PASS=
DB_DIALECT=mysql

JWT_SECRET=ganti_dengan_secret_panjang
JWT_EXPIRES_IN=1d
QR_SECRET=ganti_dengan_secret_qr
QR_TOKEN_TTL=60

# Proxy & Hardening
TRUST_PROXY=1
BODY_LIMIT=2mb

# Rate Limiting Configuration
RATE_LIMIT_API_WINDOW_MS=900000
RATE_LIMIT_API_MAX=1000
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_SCAN_WINDOW_MS=60000
RATE_LIMIT_SCAN_MAX=30

# Bridge SSO Configuration (eCampuz / Portal Akademik UIN SSC)
BRIDGE_SSO_ENABLED=true
BRIDGE_SSO_BASE_URL=https://bridge.uinssc.ac.id
BRIDGE_SSO_TIMEOUT=8
BRIDGE_SSO_SIMULATE=false

